# --- Supabase (bez nich běží aplikace v ukázkovém režimu) ---
# Návod: docs/supabase-nastaveni.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Tajný klíč — jen na serveru (pozvánky, změna rolí). Nikdy necommitovat.
SUPABASE_SECRET_KEY=

# Přihlášení přes Google: nastav na 1, až bude Google zapnutý v Supabase
# (Authentication → Sign In / Providers → Google). Do té doby tlačítko jen vysvětlí, ať se přihlásí heslem.
NEXT_PUBLIC_GOOGLE_LOGIN=

# Veřejná adresa aplikace (odkazy v e-mailech). Na Vercelu např. https://sciocamp.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Ukázkový režim ---
# Podpis session cookie, na Vercelu povinné (aspoň 32 znaků): openssl rand -base64 48
SESSION_SECRET=

# --- Jen pro npm run seed (volitelné) ---
SEED_PASSWORD=

# GIFy ve zprávách a chatu (klíč z developers.giphy.com, typ „API“). Bez něj se GIF v nabídce „+“ neukáže.
NEXT_PUBLIC_GIPHY_KEY=

# Noční úklid nepoužívaných souborů (Vercel Cron). Libovolný dlouhý náhodný řetězec.
CRON_SECRET=
